# CEPALCO API — copy to .env. Keep credentials server-side and never commit .env.

# Supabase server access. Use the service_role/secret key here only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CEPALCO_API_PORT=4102
# CORS_ORIGIN=http://localhost:5174
# DATABASE_PATH=../../data/civicalert.sqlite

# Google Gmail OAuth. The OAuth client secret is not an API key.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=
CEPALCO_GMAIL_SENDER_EMAIL=
# GMAIL_CEPALCO_REDIRECT_URI=http://localhost:4102/oauth/gmail/callback
# CEPALCO_FRONTEND_URL=http://localhost:5174

# CEPALCO Meta app/page settings. Page must be managed by the connected Meta app.
CEPALCO_META_FACEBOOK_PAGE_ID=
CEPALCO_META_FACEBOOK_PAGE_ACCESS_TOKEN=
CEPALCO_META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
CEPALCO_META_INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0
# Public HTTPS base URL of this API; Meta must be able to fetch Instagram images from it.
CEPALCO_META_PUBLIC_BASE_URL=

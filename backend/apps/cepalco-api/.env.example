# Gmail advisory notifications - CEPALCO
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
CEPALCO_GMAIL_SENDER_EMAIL=
# GMAIL_CEPALCO_REDIRECT_URI=http://localhost:4102/oauth/gmail/callback
# CEPALCO_FRONTEND_URL=http://localhost:5174

# Meta (Facebook/Instagram) publishing - optional; fill these values to enable.
# Facebook Page publishing
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram Business publishing (can reuse the Facebook page access token)
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
# Shared Meta settings
META_GRAPH_API_VERSION=v19.0
META_PUBLIC_BASE_URL=http://localhost:4102

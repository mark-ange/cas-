# Water District API - copy to .env.local and fill locally; do not commit credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WATER_API_PORT=4103
WATER_FRONTEND_URL=http://localhost:5175

# Gmail OAuth notifications
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_WATER_REDIRECT_URI=http://localhost:4103/oauth/gmail/callback
WATER_GMAIL_SENDER_EMAIL=

# Optional Meta publishing
WATER_META_FACEBOOK_PAGE_ID=
WATER_META_FACEBOOK_PAGE_ACCESS_TOKEN=
WATER_META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
WATER_META_INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0
WATER_META_PUBLIC_BASE_URL=http://localhost:4103

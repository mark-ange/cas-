# Water District API — copy to .env for local development. Never commit .env.
# Required application data store (server-only service-role key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

WATER_API_PORT=4103
# CORS_ORIGIN=http://localhost:5175
# DATABASE_PATH=../../data/civicalert.sqlite

# Gmail advisory notifications — leave blank to keep Gmail delivery disabled.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=
WATER_GMAIL_SENDER_EMAIL=
# GMAIL_WATER_REDIRECT_URI=http://localhost:4103/oauth/gmail/callback
# WATER_FRONTEND_URL=http://localhost:5175

# Water District Meta publishing — credentials are utility-scoped and server-only.
WATER_META_FACEBOOK_PAGE_ID=
WATER_META_FACEBOOK_PAGE_ACCESS_TOKEN=
WATER_META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
WATER_META_INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0
# Public HTTPS base URL for this API. Instagram fetches the saved image from it.
WATER_META_PUBLIC_BASE_URL=

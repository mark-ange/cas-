# =============================================================================
# Community Alert System (CAS) — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file or expose it publicly.
# =============================================================================

# --- Backend server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
NODE_ENV=development

# --- Frontend (Vite dev server) ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# --- PostgreSQL database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cas_dev?schema=public"
POSTGRES_USER=cas_user
POSTGRES_PASSWORD=cas_password_change_me
POSTGRES_DB=cas_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Session / JWT ---
# Generate a strong secret:  openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Initial admin (used by seed script only) ---
INITIAL_ADMIN_EMAIL=admin@cas.local
INITIAL_ADMIN_PASSWORD=ChangeMeNow!123
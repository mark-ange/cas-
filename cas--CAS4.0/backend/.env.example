# Shared Supabase project settings. Keep the service-role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API ports and local storage
RESIDENT_API_PORT=4101
CEPALCO_API_PORT=4102
WATER_API_PORT=4103
DATABASE_PATH=backend/data/civicalert.sqlite
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Gmail OAuth (required for live email delivery)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
CEPALCO_GMAIL_SENDER_EMAIL=
WATER_GMAIL_SENDER_EMAIL=
# Defaults match the local callback URLs; set these only when using custom URLs.
# GMAIL_CEPALCO_REDIRECT_URI=http://localhost:4102/oauth/gmail/callback
# GMAIL_WATER_REDIRECT_URI=http://localhost:4103/oauth/gmail/callback
# CEPALCO_FRONTEND_URL=http://localhost:5174
# WATER_FRONTEND_URL=http://localhost:5175

# Shared Meta settings (used by Water District and as CEPALCO fallbacks)
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_PUBLIC_BASE_URL=
META_GRAPH_API_VERSION=v24.0

# Optional per-utility Meta overrides; uncomment and fill only when needed.
# CEPALCO_META_FACEBOOK_PAGE_ID=
# CEPALCO_META_FACEBOOK_PAGE_ACCESS_TOKEN=
# CEPALCO_META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
# CEPALCO_META_INSTAGRAM_ACCESS_TOKEN=
# CEPALCO_META_PUBLIC_BASE_URL=
# CEPALCO_META_GRAPH_API_VERSION=v24.0
# WATER_META_FACEBOOK_PAGE_ID=
# WATER_META_FACEBOOK_PAGE_ACCESS_TOKEN=
# WATER_META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
# WATER_META_INSTAGRAM_ACCESS_TOKEN=
# WATER_META_PUBLIC_BASE_URL=
# WATER_META_GRAPH_API_VERSION=v24.0
